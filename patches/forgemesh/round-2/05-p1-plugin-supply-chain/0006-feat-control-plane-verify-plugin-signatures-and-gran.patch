+    permissions: tuple[Permission, ...]
+
+    @field_validator("plugin_id")
+    @classmethod
+    def _unversioned(cls, value: str) -> str:
+        if ":" in value:
+            raise ValueError(
+                f"pluginId must be a plugin metadata.id without a version, got {value!r}"
+            )
+        return value
+
+    @field_validator("permissions")
+    @classmethod
