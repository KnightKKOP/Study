From f55122b4d8491d17d2051a9bab1e7d5efcce4b40 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 12 Oct 2026 16:40:13 +0000
Subject: [PATCH 02/10] fix(reconciler): do not report Ready for an instance
 that is gone

A deployment run can succeed and the control plane restart before the
pass that writes Ready. With launchers whose instances end with the
control plane process, the resumed pass would then publish the dead
instance in status.endpoints with Ready=True.

ReconciliationController takes an optional launcher. When one is given,
the Verifying pass that would write Ready first asks
launcher.is_running(); an instance that is not running moves the
service to Failed with Ready=False (InstanceLost) and releases its
allocation, since nothing holds the devices any more. Failed stays
final: the user deletes and re-creates the service.
---
 .../forgemesh/controlplane/reconciler/core.py | 21 ++++++++-
 .../controlplane/test_deployment_lifecycle.py | 47 +++++++++++++++++--
 2 files changed, 64 insertions(+), 4 deletions(-)

diff --git a/packages/control-plane/src/forgemesh/controlplane/reconciler/core.py b/packages/control-plane/src/forgemesh/controlplane/reconciler/core.py
index 47bd1ea..b8b170c 100644
--- a/packages/control-plane/src/forgemesh/controlplane/reconciler/core.py
+++ b/packages/control-plane/src/forgemesh/controlplane/reconciler/core.py
@@ -23,7 +23,8 @@
 ``Deploying → Verifying → Ready``
     按同一幂等键 find_run() 查询运行：实例启动后进入 ``Verifying``；运行成功后进入
     ``Ready``，写入 ``status.endpoints``（取自 ``launch-instance`` 的结果）与 ``Ready=True``。
-    运行未结束时每 ``workflow_poll_interval`` 秒查询一次。
+    运行未结束时每 ``workflow_poll_interval`` 秒查询一次。注入启动器时，写入 ``Ready``
+    之前先确认实例仍在运行。
 
 只有进入 ``Ready`` 或 ``Failed`` 的一轮返回 ``done=True``（登记去重键）；其余各轮返回
 ``done=False``，同一 generation 的去重键不会挡住下一轮。
@@ -39,6 +40,8 @@
   补偿没能停止实例时保留分配，删除资源时再停止实例、释放分配；找不到运行
   （``WorkflowRunNotFound``，如工作流数据库被重置）或运行成功却没有报告实例（运行时
   不返回步骤输出）时同样进入 ``Failed`` 并保留分配。
+* 运行成功、实例却已不在运行（如控制平面在运行成功之后、写入 ``Ready`` 之前重启，
+  实例随进程结束）：``phase=Failed``、``Ready=False``（``InstanceLost``），释放分配。
 * ``Failed`` 是终态：资源状态机只允许它转入 ``Terminating``，协调器不自动重试，删除后
   重新创建资源即可再次部署。
 
@@ -82,6 +85,7 @@ from ..deployment import (
     LAUNCH_INSTANCE,
     LaunchedInstance,
     LaunchRequest,
+    RuntimeLauncher,
     deployment_inputs,
     deployment_run_key,
     deployment_workflow,
@@ -218,6 +222,9 @@ class ReconciliationController(Reconciler):
             避免"已登记、状态却没写进去"（控制器管理器使用）。默认 ``True``。
         workflow_poll_interval: 部署运行进行中时两次查询之间的秒数，也是启动或查询失败
             后退避的起点（之后每次翻倍，最多 :data:`MAX_RETRY_DELAY_SECONDS`）。
+        launcher: 可选，部署工作流使用的启动器；注入时写入 ``Ready`` 之前以
+            :meth:`~forgemesh.controlplane.deployment.RuntimeLauncher.is_running` 确认实例
+            仍在运行，否则进入 ``Failed``（``InstanceLost``）。
 
     Raises:
         ValueError: 注入了工作流运行时却没有 ``release_provider``，或
@@ -235,6 +242,7 @@ class ReconciliationController(Reconciler):
         processed_store: ProcessedKeyStore | None = None,
         record_dedup_keys: bool = True,
         workflow_poll_interval: float = 2.0,
+        launcher: RuntimeLauncher | None = None,
     ) -> None:
         if workflow_runtime is not None and release_provider is None:
             raise ValueError(
@@ -252,6 +260,7 @@ class ReconciliationController(Reconciler):
         self._processed_store = processed_store
         self._record_dedup_keys = record_dedup_keys
         self._poll_interval = workflow_poll_interval
+        self._launcher = launcher
         # 已处理的去重键（内存级回退路径；processed_store 注入时以 SQLite
         # 持久化为准——architecture §5.5 不依赖单进程内存状态）。
         self._processed_keys: set[str] = set()
@@ -483,6 +492,16 @@ class ReconciliationController(Reconciler):
         if run.status is WorkflowStatus.SUCCEEDED and instance is not None:
             if phase == InferencePhase.DEPLOYING:
                 return self._verifying(instance, requeue_after=0.0)
+            if self._launcher is not None and not await self._launcher.is_running(
+                instance.instance_id
+            ):
+                return await self._fail(
+                    ctx,
+                    "InstanceLost",
+                    f"instance {instance.instance_id} at {instance.url} is not running any "
+                    "more; delete and re-create the service to deploy it again",
+                    release_allocation=True,
+                )
             return await self._ready(ctx, instance)
         if run.terminal:
             return await self._fail_run(ctx, run, instance)
diff --git a/tests/unit/controlplane/test_deployment_lifecycle.py b/tests/unit/controlplane/test_deployment_lifecycle.py
index 5ac1e7a..c2b209f 100644
--- a/tests/unit/controlplane/test_deployment_lifecycle.py
+++ b/tests/unit/controlplane/test_deployment_lifecycle.py
@@ -4,7 +4,7 @@
 * 创建的资源每轮推进一个 phase（``Pending`` → ``Scheduling`` → ``Preparing`` →
   ``Deploying`` → ``Verifying`` → ``Ready``），``status.endpoints`` 是启动器返回的实例；
 * 重启（``Ready`` 之后、启动部署的一轮被重放、启动实例的中途）不会启动第二个实例，也
-  不会再分配；
+  不会再分配；运行成功之后、写入 ``Ready`` 之前重启而实例已不在时，资源进入 ``Failed``；
 * 部署工作流没能启动时保留分配并重试；部署失败时实例被停止、分配释放，资源停在
   ``Failed``；补偿没能停止的实例在删除资源时停止；
 * 部署中途或 ``Ready`` 之后删除资源：取消运行、停止实例、释放分配、物理删除；
@@ -12,7 +12,7 @@
 
 测试以 ``asyncio.run`` 驱动异步方法，不依赖 pytest-asyncio。“重启”在同一个事件循环中
 关闭全部组件，再以同一数据库文件重新组装；启动器对象沿用，相当于实例在控制平面重启后
-仍在运行。
+仍在运行，换一个新的启动器对象则相当于实例随进程结束。
 """
 
 from __future__ import annotations
@@ -34,6 +34,7 @@ from forgemesh.controlplane.deployment import (
     LaunchRequest,
     RuntimeLauncher,
     deployment_run_key,
+    launched_instance,
 )
 from forgemesh.controlplane.reconciler import (
     ProcessedKeyStore,
@@ -175,10 +176,11 @@ class _ControlPlane:
     """一个控制平面进程的组件，组装方式与应用相同（在 ``async with`` 内使用）。
 
     进入时调用 ``recover()``（返回值存于 :attr:`recovered`）；退出时按应用的顺序关闭：
-    控制器 → 工作流运行时 → 工作流存储 → 去重键存储 → 注册表。
+    控制器 → 工作流运行时 → 启动器 → 工作流存储 → 去重键存储 → 注册表。
     """
 
     def __init__(self, db: str, launcher: RuntimeLauncher) -> None:
+        self.launcher = launcher
         self.registry = SQLiteRegistry(db)
         self.processed = ProcessedKeyStore(db)
         self.workflow_store = WorkflowStore(workflow_db_path(db))
@@ -192,6 +194,7 @@ class _ControlPlane:
             processed_store=self.processed,
             record_dedup_keys=False,
             workflow_poll_interval=POLL_SECONDS,
+            launcher=launcher,
         )
         self.manager = ControllerManager(self.registry, reconciler, poll_interval=POLL_SECONDS)
         self.recovered: list[str] = []
@@ -203,6 +206,7 @@ class _ControlPlane:
     async def __aexit__(self, *exc_info: object) -> None:
         await self.manager.stop()
         await self.runtime.aclose()
+        await self.launcher.aclose()
         await self.workflow_store.close()
         await self.processed.close()
