From a8c6bf49d8af9ef2c33e7a2e8928ad5e9ccd0f9e Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 12 Oct 2026 02:35:50 +0000
Subject: [PATCH 4/8] fix(registry): apply label selectors before LIMIT and
 reject non-positive limits

list() fetched one page with LIMIT and only then filtered labels in Python, so
matches outside the first page were never returned and paging silently skipped
items. A negative limit was passed straight to SQLite, where LIMIT -1 means
unbounded.

Filter labels in SQL with json_extract before ORDER BY/LIMIT and raise
ValueError for limit < 1.
---
 .../forgemesh/controlplane/registry/store.py  | 28 +++++++++----
 tests/contract/test_registry_hardening.py     | 42 +++++++++++++++++++
 2 files changed, 62 insertions(+), 8 deletions(-)

diff --git a/packages/control-plane/src/forgemesh/controlplane/registry/store.py b/packages/control-plane/src/forgemesh/controlplane/registry/store.py
index fc10e30..cd95aba 100644
--- a/packages/control-plane/src/forgemesh/controlplane/registry/store.py
+++ b/packages/control-plane/src/forgemesh/controlplane/registry/store.py
@@ -250,6 +250,13 @@ class SQLiteRegistry(ResourceRegistry):
             return
         machine.validate(current, target)
 
+    @staticmethod
+    def _label_path(key: str) -> str:
+        """把标签键转换为 SQLite JSON 路径（键整体加双引号，兼容 ``.`` 与 ``/``）。"""
+        if '"' in key or "\\" in key:
+            raise ValueError(f"invalid label key: {key!r}")
+        return f'$.metadata.labels."{key}"'
+
     @staticmethod
     def _encode_token(namespace: str | None, name: str) -> str:
         """将分页游标 ``(namespace, name)`` 编码为 opaque base64 字符串。"""
@@ -443,10 +450,19 @@ class SQLiteRegistry(ResourceRegistry):
     ) -> builtins.list[Resource]:
         """按 ``kind`` + 可选 ``namespace`` / ``labels`` 过滤列出资源（分页）。
 
+        标签过滤在 SQL 中先于 ``LIMIT`` 执行，保证每页返回的都是匹配项。
         ``watch=True`` 在阶段 P1 暂未实现，抛 :class:`NotImplementedError`。
+
+        Raises:
+            ValueError: ``limit`` 小于 1，或标签键包含双引号 / 反斜杠。
         """
         if watch:
             raise NotImplementedError("watch stream is not implemented in phase P1")
+        if limit < 1:
+            raise ValueError(f"limit must be >= 1, got {limit}")
+        label_paths = [
+            (self._label_path(key), value) for key, value in sorted((labels or {}).items())
+        ]
 
         def _list() -> list[Resource]:
             sql = "SELECT body FROM resources WHERE tenant_id=? AND kind=?"
@@ -454,6 +470,9 @@ class SQLiteRegistry(ResourceRegistry):
             if namespace is not None:
                 sql += " AND namespace IS ?"
                 params.append(namespace)
+            for path, value in label_paths:
+                sql += " AND json_extract(body, ?) = ?"
+                params.extend([path, value])
             if continue_token is not None:
                 cursor_ns, cursor_name = self._decode_token(continue_token)
                 cursor_ns_key = cursor_ns if cursor_ns is not None else ""
@@ -466,14 +485,7 @@ class SQLiteRegistry(ResourceRegistry):
             sql += " ORDER BY COALESCE(namespace, ''), name LIMIT ?"
             params.append(limit)
             rows = self._conn.execute(sql, tuple(params)).fetchall()
-            results = [self._row_to_resource(r) for r in rows]
-            if labels:
-                results = [
-                    res
-                    for res in results
-                    if all(res.metadata.labels.get(k) == v for k, v in labels.items())
-                ]
-            return results
+            return [self._row_to_resource(r) for r in rows]
 
         return await self._run(_list)
 
diff --git a/tests/contract/test_registry_hardening.py b/tests/contract/test_registry_hardening.py
index 7dd449a..4a5f8f5 100644
--- a/tests/contract/test_registry_hardening.py
+++ b/tests/contract/test_registry_hardening.py
@@ -238,3 +238,45 @@ def test_release_allocation_does_not_overwrite_terminal_state() -> None:
             await reg.close()
 
     asyncio.run(scenario())
+
+
+@pytest.mark.contract
+def test_label_selector_is_applied_before_limit() -> None:
+    """标签过滤先于 LIMIT：匹配项排在第一页之外时也必须被返回且可分页遍历。"""
+
+    async def scenario() -> None:
+        reg = SQLiteRegistry(":memory:")
+        try:
+            for i in range(150):
+                labels = {"app.kubernetes.io/name": "target"} if i >= 140 else {}
+                await reg.put(_make_resource(f"res-{i:03d}", labels=labels))
+            selector = {"app.kubernetes.io/name": "target"}
+
+            first_page = await reg.list(KIND, TENANT, labels=selector, limit=100)
+            assert [r.metadata.name for r in first_page] == [
+                f"res-{i:03d}" for i in range(140, 150)
+            ]
+
+            seen: list[str] = []
+            token = None
+            while True:
+                page = await reg.list(KIND, TENANT, labels=selector, limit=4, continue_token=token)
+                if not page:
+                    break
+                seen.extend(r.metadata.name for r in page)
+                last = page[-1].metadata
+                token = SQLiteRegistry._encode_token(last.namespace, last.name)
+            assert seen == [f"res-{i:03d}" for i in range(140, 150)]
+        finally:
+            await reg.close()
+
+    asyncio.run(scenario())
+
+
+@pytest.mark.contract
+@pytest.mark.parametrize("limit", [0, -1])
+def test_list_rejects_non_positive_limit(limit: int) -> None:
+    """SQLite 中 LIMIT -1 表示不限条数，必须在入口拒绝。"""
+    reg = SQLiteRegistry(":memory:")
+    with pytest.raises(ValueError):
+        asyncio.run(reg.list(KIND, TENANT, limit=limit))
