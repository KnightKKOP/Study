From 1a5abb7750f19805a65caaa224239194017d913a Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 12 Oct 2026 06:57:47 +0000
Subject: [PATCH 05/11] ci: vet the gateway, run its tests with the race
 detector and smoke-test compose

The Go job only built and tested the gateway. It now also fails on
files that are not gofmt-formatted, runs go vet and runs the tests
with -race; the resolver and the rate limiter share state between
goroutines.

The new compose-smoke job runs scripts/compose_smoke.sh, which builds
both images and checks the compose topology end to end, so the
Dockerfiles, the compose file and the packaging of the control plane
are exercised on every pull request.
---
 .github/workflows/ci.yml | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 8c2bde9..4f0dead 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -72,11 +72,35 @@ jobs:
           cache: true
           cache-dependency-path: gateway/go.sum
 
+      - name: Go format
+        run: |
+          unformatted=$(gofmt -l .)
+          if [ -n "$unformatted" ]; then
+            echo "ERROR: run gofmt -w on:"
+            echo "$unformatted"
+            exit 1
+          fi
+
+      - name: Go vet
+        run: go vet ./...
+
       - name: Go build
         run: go build ./...
 
-      - name: Go test
-        run: go test ./...
+      - name: Go test (race detector)
+        run: go test -race ./...
+
+  compose-smoke:
+    name: Compose · end-to-end smoke
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      # 构建两个镜像并启动 deploy/docker/docker-compose.yaml，经网关创建、读取推理服务。
+      - name: Compose smoke test
+        run: scripts/compose_smoke.sh
   architecture-docs:
     name: Architecture docs & schema validation
     runs-on: ubuntu-latest
-- 
