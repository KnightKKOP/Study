From a54cdcfed8645955f929e2c10c3489942bb74491 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 12 Oct 2026 02:32:18 +0000
Subject: [PATCH 2/8] fix(registry): enforce identity uniqueness when namespace
 is NULL

SQLite primary keys allow NULL and treat NULLs as distinct, so resources
without a namespace could be created repeatedly under the same name, and a
single DELETE then removed every copy.

Add a unique expression index on (tenant_id, kind, COALESCE(namespace, ''), name).
Opening a legacy database that already holds duplicates fails with
PreconditionFailedError instead of silently dropping rows.
---
 .../forgemesh/controlplane/registry/store.py  | 30 ++++++++++++-
 tests/contract/test_registry_hardening.py     | 42 ++++++++++++++++++-
 2 files changed, 70 insertions(+), 2 deletions(-)

diff --git a/packages/control-plane/src/forgemesh/controlplane/registry/store.py b/packages/control-plane/src/forgemesh/controlplane/registry/store.py
index 00f04d0..4b97aef 100644
--- a/packages/control-plane/src/forgemesh/controlplane/registry/store.py
+++ b/packages/control-plane/src/forgemesh/controlplane/registry/store.py
@@ -59,7 +59,7 @@ from dataclasses import dataclass, field
 from typing import Any, TypeVar
 from uuid import uuid4
 
-from forgemesh.core.errors import ConflictError, NotFoundError
+from forgemesh.core.errors import ConflictError, NotFoundError, PreconditionFailedError
 from forgemesh.core.objects import Resource
 from forgemesh.core.registry import ResourceRegistry
 from forgemesh.resource.allocation import Allocation, AllocationStatus
@@ -173,8 +173,36 @@ class SQLiteRegistry(ResourceRegistry):
         """创建表与索引（幂等），并对存量库做列迁移。"""
         self._conn.executescript(_SCHEMA_SQL)
         self._migrate_legacy_resources()
+        self._ensure_identity_index()
         self._conn.commit()
 
+    def _ensure_identity_index(self) -> None:
+        """建立把 NULL namespace 视为相等的身份唯一索引。
+
+        SQLite 主键允许 NULL 且 NULL 互不相等，仅靠主键无法阻止 namespace 为空的
+        资源重名。存量库已存在重复记录时拒绝打开，避免静默删除数据。
+        """
+        exists = self._conn.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='index' AND name='ux_resources_identity'"
+        ).fetchone()
+        if exists is not None:
+            return
+        duplicate = self._conn.execute(
+            "SELECT tenant_id, kind, COALESCE(namespace, '') AS ns, name, COUNT(*) AS n "
+            "FROM resources GROUP BY tenant_id, kind, ns, name HAVING n > 1 LIMIT 1"
+        ).fetchone()
+        if duplicate is not None:
+            raise PreconditionFailedError(
+                "duplicate resources must be removed before upgrading: "
+                f"tenant_id={duplicate['tenant_id']} kind={duplicate['kind']} "
+                f"namespace={duplicate['ns']!r} name={duplicate['name']} "
+                f"count={duplicate['n']}",
+            )
+        self._conn.execute(
+            "CREATE UNIQUE INDEX ux_resources_identity "
+            "ON resources(tenant_id, kind, COALESCE(namespace, ''), name)"
+        )
+
     def _migrate_legacy_resources(self) -> None:
         """存量库幂等迁移：以 ``PRAGMA table_info`` 探测后补 ``phase`` /
         ``finalizers`` 列（内存库 ``:memory:`` 每次新建无此问题，但保持幂等）。
diff --git a/tests/contract/test_registry_hardening.py b/tests/contract/test_registry_hardening.py
index 3d4cd3f..faeecda 100644
--- a/tests/contract/test_registry_hardening.py
+++ b/tests/contract/test_registry_hardening.py
@@ -6,10 +6,11 @@
 from __future__ import annotations
 
 import asyncio
+import sqlite3
 
 import pytest
 from forgemesh.controlplane.registry import SQLiteRegistry
-from forgemesh.core.errors import ConflictError
+from forgemesh.core.errors import ConflictError, PreconditionFailedError
 from forgemesh.core.objects import ObjectMeta, Resource
 
 KIND = "Node"
@@ -55,3 +56,42 @@ def test_shared_instance_concurrent_writes_are_not_lost() -> None:
             await reg.close()
 
     asyncio.run(scenario())
+
+
+@pytest.mark.contract
+def test_create_without_namespace_rejects_duplicate_name() -> None:
+    """namespace 为空的同名资源只能创建一次（SQLite 主键 NULL 互不相等）。"""
+
+    async def scenario() -> None:
+        reg = SQLiteRegistry(":memory:")
+        try:
+            await reg.put(_make_resource("cluster-scoped", namespace=None))
+            with pytest.raises(ConflictError):
+                await reg.put(_make_resource("cluster-scoped", namespace=None))
+            assert len(await reg.list(KIND, TENANT)) == 1
+        finally:
+            await reg.close()
+
+    asyncio.run(scenario())
+
+
+@pytest.mark.contract
+def test_open_refuses_legacy_db_with_duplicate_identities(tmp_path) -> None:
+    """存量库已有重复身份时拒绝打开，而不是静默删除其中一条。"""
+    db_file = tmp_path / "legacy.db"
+    reg = SQLiteRegistry(str(db_file))
+    asyncio.run(reg.close())
+
+    conn = sqlite3.connect(db_file)
+    conn.execute("DROP INDEX ux_resources_identity")
+    for _ in range(2):
+        conn.execute(
+            "INSERT INTO resources (tenant_id, kind, namespace, name, body) "
+            "VALUES (?, ?, NULL, ?, '{}')",
+            (TENANT, KIND, "dup"),
+        )
+    conn.commit()
+    conn.close()
+
+    with pytest.raises(PreconditionFailedError, match="name=dup"):
+        SQLiteRegistry(str(db_file))
