From d33bc0f3384bc5848799ccabeafdf6c130205dfd Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 13 Oct 2026 02:37:09 +0000
Subject: [PATCH 1/8] build(cli): declare the PyYAML and control plane
 dependencies

forgemesh.cli.commands imports yaml and
forgemesh.controlplane.registry at module level, but forgemesh-cli
only declared forgemesh-core. Installed on its own, the package
produced a forgemesh command that failed with ModuleNotFoundError
before parsing any argument; the dev environment hid this because it
installs every package.

Declare pyyaml (same lower bound as plugin-sdk) and
forgemesh-control-plane. The fresh-virtualenv import check added in
the next commit covers this.
---
 CHANGELOG.md                | 1 +
 packages/cli/pyproject.toml | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 6b2fc00..d8d7aa2 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -135,6 +135,7 @@
 - 全部 10 个插件清单与示例清单的 `entrypoint` 写成 `python -m forgemesh_<名称>`，而这些模块并不存在，没有一个插件能按清单加载；入口冒烟只用 `entrypoint` 判断是否跳过，随后绕开它按文件路径加载 `provider.py`（或包的 `__init__.py`），只断言其中有公有类。现改为真实的 `<模块>:<类>` 入口，冒烟按入口加载（见 Changed）。
 - 全部 10 个插件与示例清单声明 `isolation: restricted-rpc`，而受限 RPC 宿主并不存在，插件实际都在宿主进程内运行；其中 `decision-typesafe-jev` 在进程内经 `urllib` 直接请求 TypeSafe API。现全部改为 `in-process`（`decision-typesafe-jev` 已申请 `network.egress`）。
 - `plugin-sdk` 包补齐 `pyyaml` 依赖声明：`forgemesh.plugin.sdk` 与签名工具都用它读取清单，此前独立安装（如控制平面镜像）后导入 `forgemesh.plugin.sdk` 即失败。
+- `cli` 包补齐 `pyyaml` 与 `forgemesh-control-plane` 依赖声明：`forgemesh.cli.commands` 用它们读取清单、打开 Registry，此前独立安装后执行 `forgemesh` 即失败。
 
 ### Security
 
diff --git a/packages/cli/pyproject.toml b/packages/cli/pyproject.toml
index 7a251ec..e29c5d9 100644
--- a/packages/cli/pyproject.toml
+++ b/packages/cli/pyproject.toml
@@ -8,7 +8,9 @@ version = "0.0.1"
 description = "ForgeMesh command line interface (apply/get/describe/version)"
 requires-python = ">=3.12"
 dependencies = [
+    "pyyaml>=6.0.1",
     "forgemesh-core",
+    "forgemesh-control-plane",
 ]
 
 [project.scripts]
