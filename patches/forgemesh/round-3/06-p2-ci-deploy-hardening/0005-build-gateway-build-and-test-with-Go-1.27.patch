From 7d19d72ea4e8095dab0f348f8ddc19b1753aaee8 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 13 Oct 2026 02:49:40 +0000
Subject: [PATCH 5/8] build(gateway): build and test with Go 1.27

The gateway image and the CI go job used Go 1.22, which has been out
of support since February 2025. The gateway depends only on the
standard library, which is compiled into the binary, so its security
fixes arrive only with Go patch releases: govulncheck reports 41
vulnerabilities in standard library code the gateway calls (net/http,
crypto/tls, crypto/x509, net/url and others) with go1.22.12, the last
1.22 release, and none with go1.26.9 or go1.27.2.

Build the image from golang:1.27 and run the go job with the same
minor version, read from a workflow-level GO_VERSION so that jobs
cannot drift apart; both take the latest patch release. go.mod keeps
"go 1.22": the code still builds with older toolchains, and go vet
reports uses of standard library symbols newer than that.
---
 .github/workflows/ci.yml         | 7 ++++++-
 deploy/docker/Dockerfile.gateway | 4 +++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 7bfd690..23ac3f2 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -11,6 +11,11 @@ concurrency:
   group: ci-${{ github.ref }}
   cancel-in-progress: true
 
+env:
+  # 网关的 Go 次版本，与 deploy/docker/Dockerfile.gateway 保持一致。setup-go 取它的最新补丁版本，
+  # 标准库的漏洞修复随补丁版本发布；这个次版本停止维护之前一起升级。
+  GO_VERSION: "1.27"
+
 jobs:
   python:
     name: Python ${{ matrix.python-version }} · lint & test
@@ -88,7 +93,7 @@ jobs:
       - name: Set up Go
         uses: actions/setup-go@v5
         with:
-          go-version: "1.22"
+          go-version: ${{ env.GO_VERSION }}
           cache: true
           cache-dependency-path: gateway/go.sum
 
diff --git a/deploy/docker/Dockerfile.gateway b/deploy/docker/Dockerfile.gateway
index 6404fb4..024f65f 100644
--- a/deploy/docker/Dockerfile.gateway
+++ b/deploy/docker/Dockerfile.gateway
@@ -2,7 +2,9 @@
 #   docker build -f deploy/docker/Dockerfile.gateway -t forgemesh/gateway:0.0.1 .
 #
 # 静态编译（网关只依赖标准库），运行在 distroless 镜像中，用户为 nonroot（uid 65532）。
-FROM golang:1.22 AS build
+# 标准库编译进二进制，它的漏洞修复随 Go 补丁版本发布：构建镜像使用与 CI 相同的 Go 次版本
+# （.github/workflows/ci.yml 中的 GO_VERSION）的最新补丁，重新构建镜像即可取得修复。
+FROM golang:1.27 AS build
 
 WORKDIR /src
 COPY gateway/ ./
-- 
