From eca5ba10f4507135a0c20918d00156c1156229b4 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 13 Oct 2026 02:44:11 +0000
Subject: [PATCH 4/8] ci: fail the python job when total coverage drops below
 95%

pytest-cov was already a dev dependency but never used, so coverage
could only go down unnoticed. The measured total is 95.87% (5733
statements, 1150 branches); set fail_under = 95, the floor of the
measured value, and only ever raise it.

precision = 2 is needed as well: coverage rounds the total to
precision digits before comparing, and with the default of 0 a total
of 94.5% would round up to 95% and pass. CI now runs pytest --cov,
and make coverage runs the same check locally.
---
 .github/workflows/ci.yml | 5 +++--
 Makefile                 | 7 ++++++-
 pyproject.toml           | 4 ++++
 3 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 182b8a3..7bfd690 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -51,8 +51,9 @@ jobs:
       - name: Ruff lint
         run: python -m ruff check .
 
-      - name: Pytest
-        run: python -m pytest
+      # 总覆盖率低于 pyproject.toml 中的 fail_under 时失败。
+      - name: Pytest (coverage floor)
+        run: python -m pytest --cov
 
   package-imports:
     name: Packages · fresh-venv imports
diff --git a/Makefile b/Makefile
index f5640a7..d126bae 100644
--- a/Makefile
+++ b/Makefile
@@ -9,6 +9,7 @@
 # 常用目标：
 #   make install   创建 .venv，安装全部子包（editable）+ 开发依赖
 #   make test      运行全部测试（pytest）
+#   make coverage  运行全部测试并检查覆盖率下限（与 CI 相同）
 #   make lint      ruff 静态检查
 #   make fmt       ruff 自动修复 + 格式化
 #   make clean     清理构建与缓存产物
@@ -21,7 +22,7 @@ VENV_PIP:= $(VENV)/bin/pip
 
 .DEFAULT_GOAL := help
 
-.PHONY: help install deps test test-unit test-contract lint fmt clean
+.PHONY: help install deps test test-unit test-contract coverage lint fmt clean
 
 help:
 	@echo "ForgeMesh 顶层命令："
@@ -29,6 +30,7 @@ help:
 	@echo "  make test           运行全部测试（pytest）"
 	@echo "  make test-unit      仅运行单元测试"
 	@echo "  make test-contract  仅运行契约测试"
+	@echo "  make coverage       运行全部测试并检查覆盖率下限（与 CI 相同）"
 	@echo "  make lint           ruff 静态检查"
 	@echo "  make fmt            ruff 自动修复与格式化"
 	@echo "  make clean          清理构建与缓存产物"
@@ -74,6 +76,9 @@ test-unit:
 test-contract:
 	$(VENV_PY) -m pytest tests/contract
 
+coverage:
+	$(VENV_PY) -m pytest --cov
+
 lint:
 	$(VENV_PY) -m ruff check .
 
diff --git a/pyproject.toml b/pyproject.toml
index 5df788c..4eaf2d0 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -49,6 +49,10 @@ source = ["packages"]
 omit = ["*/tests/*", "*/__init__.py"]
 
 [tool.coverage.report]
+# 总覆盖率下限（`pytest --cov` 与 `coverage report` 都会检查），只升不降。precision 同时是
+# 比较之前取整的位数：默认的 0 会把 94.5% 取整成 95% 而通过。
+fail_under = 95
+precision = 2
 show_missing = true
 skip_covered = false
 exclude_lines = [
-- 
