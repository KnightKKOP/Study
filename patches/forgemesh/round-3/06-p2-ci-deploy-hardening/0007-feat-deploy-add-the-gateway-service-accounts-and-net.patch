diff --git a/deploy/kubernetes/gateway-deployment.yaml b/deploy/kubernetes/gateway-deployment.yaml
new file mode 100644
index 0000000..30f296d
--- /dev/null
+++ b/deploy/kubernetes/gateway-deployment.yaml
@@ -0,0 +1,115 @@
+# ForgeMesh 网关 Kubernetes 部署
+#
+# 镜像由 deploy/docker/Dockerfile.gateway 构建；推送到自己的镜像仓库后替换 image。
+# 与控制平面共用 Secret forgemesh-api-keys 中的 key 文件（见 control-plane-deployment.yaml），
+# 经 Service forgemesh-control-plane 访问控制平面；/readyz 在控制平面就绪之后才返回 200。
+# 网关是调用方访问 API 的唯一入口：network-policies.yaml 只允许网关访问控制平面。集群外的
+# 调用方经 Ingress、LoadBalancer 等暴露 Service forgemesh-gateway 访问。
+#
+# 网关无状态，可以增加副本；限流与服务实例的解析缓存按副本各自计算（每个副本对每个租户都
+# 允许 GATEWAY_RATE_LIMIT_RPS）。推理实例的地址默认只拒绝回环、链路本地与云元数据地址，
+# 可以用 GATEWAY_INSTANCE_ALLOWED_CIDRS 限定为 Pod 网段（见 gateway/README.md「实例地址限制」）。
+# 网关不访问 Kubernetes API：以专用的 ServiceAccount 运行，不挂载它的 token。
+apiVersion: v1
+kind: ServiceAccount
+metadata:
+  name: forgemesh-gateway
+  namespace: forgemesh
+  labels:
+    app.kubernetes.io/name: gateway
+    app.kubernetes.io/part-of: forgemesh
+automountServiceAccountToken: false
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: forgemesh-gateway
+  namespace: forgemesh
+  labels:
+    app.kubernetes.io/name: gateway
+    app.kubernetes.io/part-of: forgemesh
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: gateway
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: gateway
+    spec:
+      serviceAccountName: forgemesh-gateway
+      automountServiceAccountToken: false
+      # 不注入同命名空间各 Service 的环境变量：名为 gateway 的 Service 会注入 GATEWAY_PORT 等
+      # 变量，与网关的 GATEWAY_* 配置混在一起（见 control-plane-deployment.yaml）。
+      enableServiceLinks: false
+      # 收到 SIGTERM 后网关最多用 30 秒排空在途请求（含 SSE 流），宽限期要比它长。
+      terminationGracePeriodSeconds: 35
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 65532
+        runAsGroup: 65532
+        fsGroup: 65532
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: gateway
+          image: forgemesh/gateway:0.0.1
+          imagePullPolicy: IfNotPresent
+          env:
+            - name: GATEWAY_UPSTREAM_URL
+              value: http://forgemesh-control-plane:8080
+            - name: GATEWAY_API_KEYS_FILE
+              value: /etc/forgemesh/api-keys.json
+          ports:
+            - name: http
+              containerPort: 8081
+          # /readyz 最多等控制平面的 /readyz 2 秒（gateway/internal/health），探针的超时要比它长。
+          readinessProbe:
+            httpGet:
+              path: /readyz
+              port: http
+            initialDelaySeconds: 3
+            periodSeconds: 10
+            timeoutSeconds: 3
+          livenessProbe:
+            httpGet:
+              path: /healthz
+              port: http
+            initialDelaySeconds: 5
+            periodSeconds: 10
+          resources:
+            requests:
+              cpu: "100m"
+              memory: "64Mi"
+            limits:
+              cpu: "1"
+              memory: "256Mi"
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: ["ALL"]
+          volumeMounts:
+            - name: api-keys
+              mountPath: /etc/forgemesh
+              readOnly: true
+      volumes:
+        - name: api-keys
+          secret:
+            secretName: forgemesh-api-keys
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: forgemesh-gateway
+  namespace: forgemesh
+  labels:
+    app.kubernetes.io/name: gateway
+spec:
+  selector:
+    app.kubernetes.io/name: gateway
+  ports:
+    - name: http
+      port: 8081
+      targetPort: http
diff --git a/deploy/kubernetes/launcher/fake-runtime-patch.yaml b/deploy/kubernetes/launcher/fake-runtime-patch.yaml
new file mode 100644
index 0000000..92edcbc
--- /dev/null
+++ b/deploy/kubernetes/launcher/fake-runtime-patch.yaml
@@ -0,0 +1,37 @@
+# 试用推理服务的完整闭环，不需要 GPU：为控制平面加上加速器清单与 fake 启动器
+# （strategic merge patch，与 deploy/docker/docker-compose.fake-runtime.yaml 对应）。
+#
+#   kubectl -n forgemesh create configmap forgemesh-inventory \
+#     --from-file=inventory.json=deploy/docker/fake-runtime-inventory.json
+#   kubectl apply -f deploy/kubernetes/launcher/network-policy.yaml
+#   kubectl -n forgemesh patch deployment forgemesh-control-plane \
+#     --patch-file deploy/kubernetes/launcher/fake-runtime-patch.yaml
+#
+# 每个实例是控制平面进程内的 OpenAI 兼容桩服务，监听 Pod 的全部地址、端口由内核挑选；写进
+# status.endpoints 的主机是 Pod IP（Service 只转发 8080 端口，不能写 Service 名）。实例随
+# Pod 结束：Pod 重建之后 Ready 的服务转为 Degraded，需删除后重新创建。清单挂载在
+# /etc/forgemesh-inventory，不能挂在只读的 key 文件目录 /etc/forgemesh 之下。
+spec:
+  template:
+    spec:
+      containers:
+        - name: control-plane
+          env:
+            - name: FORGEMESH_INVENTORY_FILE
+              value: /etc/forgemesh-inventory/inventory.json
+            - name: FORGEMESH_RUNTIME_LAUNCHER
+              value: fake
+            - name: FORGEMESH_FAKE_LAUNCHER_BIND_HOST
+              value: "0.0.0.0"
+            - name: FORGEMESH_FAKE_LAUNCHER_ADVERTISE_HOST
+              valueFrom:
+                fieldRef:
+                  fieldPath: status.podIP
+          volumeMounts:
+            - name: inventory
+              mountPath: /etc/forgemesh-inventory
+              readOnly: true
+      volumes:
+        - name: inventory
+          configMap:
+            name: forgemesh-inventory
diff --git a/deploy/kubernetes/launcher/network-policy.yaml b/deploy/kubernetes/launcher/network-policy.yaml
new file mode 100644
index 0000000..19a259f
--- /dev/null
+++ b/deploy/kubernetes/launcher/network-policy.yaml
@@ -0,0 +1,47 @@
+# 启用启动器（FORGEMESH_RUNTIME_LAUNCHER）时与 ../network-policies.yaml 一起应用。
+#
+# fake 与 vllm-process 的推理实例都运行在控制平面的 Pod 内，监听内核挑选的临时端口
+# （Pod 网络命名空间的 net.ipv4.ip_local_port_range，Linux 默认 32768-60999）；网关按
+# status.endpoints 直接连接 Pod IP 上的这些端口。这里只允许网关访问它们；控制平面对实例的
+# 健康检查走 Pod 内的回环地址，不受网络策略限制。
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: forgemesh-inference-instances
+  namespace: forgemesh
+spec:
+  podSelector:
+    matchLabels:
+      app.kubernetes.io/name: control-plane
+  policyTypes:
+    - Ingress
+  ingress:
+    - from:
+        - podSelector:
+            matchLabels:
+              app.kubernetes.io/name: gateway
+      ports:
+        - protocol: TCP
+          port: 32768
+          endPort: 60999
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: forgemesh-gateway-to-instances
+  namespace: forgemesh
+spec:
+  podSelector:
+    matchLabels:
+      app.kubernetes.io/name: gateway
+  policyTypes:
+    - Egress
+  egress:
+    - to:
+        - podSelector:
+            matchLabels:
+              app.kubernetes.io/name: control-plane
+      ports:
+        - protocol: TCP
+          port: 32768
+          endPort: 60999
diff --git a/deploy/kubernetes/network-policies.yaml b/deploy/kubernetes/network-policies.yaml
new file mode 100644
index 0000000..2491a53
--- /dev/null
+++ b/deploy/kubernetes/network-policies.yaml
@@ -0,0 +1,90 @@
+# ForgeMesh 命名空间的网络策略。只有执行 NetworkPolicy 的 CNI（如 Calico、Cilium）才会生效，
+# 不执行的 CNI 静默忽略这些对象。
+#
+# - 默认拒绝命名空间内全部 Pod 的入站与出站流量；
+# - 全部 Pod 都可以访问集群 DNS（kube-system 中 k8s-app=kube-dns 的 Pod，53 端口）；
+# - 控制平面只接受网关对 8080 端口的访问。kubelet 的探针与 kubectl exec / cp / port-forward
+#   不受网络策略限制，容器中的备份与恢复（docs/operations/backup-restore.md 2.5 / 3.4 节）照常进行；
+# - 网关接受任何来源对 8081 端口的访问（它是 API 的入口，自行认证），出站只能访问控制平面的 8080 端口。
+#
+# 启用启动器之后推理实例运行在控制平面的 Pod 内，还要应用 launcher/network-policy.yaml。
+# 集群外的调用方只经 Ingress 控制器访问网关时，可以把网关入站规则的来源收窄到 Ingress 控制器
+# 所在的命名空间；集群 DNS 的标签或端口不同（例如使用 NodeLocal DNSCache）时相应修改 DNS 规则。
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: forgemesh-default-deny
+  namespace: forgemesh
+spec:
+  podSelector: {}
+  policyTypes:
+    - Ingress
+    - Egress
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: forgemesh-allow-dns
+  namespace: forgemesh
+spec:
+  podSelector: {}
+  policyTypes:
+    - Egress
+  egress:
+    - to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: kube-system
+          podSelector:
+            matchLabels:
+              k8s-app: kube-dns
+      ports:
+        - protocol: UDP
+          port: 53
+        - protocol: TCP
+          port: 53
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: forgemesh-control-plane
+  namespace: forgemesh
+spec:
+  podSelector:
+    matchLabels:
+      app.kubernetes.io/name: control-plane
+  policyTypes:
+    - Ingress
+  ingress:
+    - from:
+        - podSelector:
+            matchLabels:
+              app.kubernetes.io/name: gateway
+      ports:
+        - protocol: TCP
+          port: 8080
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: forgemesh-gateway
+  namespace: forgemesh
+spec:
+  podSelector:
+    matchLabels:
+      app.kubernetes.io/name: gateway
+  policyTypes:
+    - Ingress
+    - Egress
+  ingress:
+    - ports:
+        - protocol: TCP
+          port: 8081
+  egress:
+    - to:
+        - podSelector:
+            matchLabels:
+              app.kubernetes.io/name: control-plane
+      ports:
+        - protocol: TCP
+          port: 8080
