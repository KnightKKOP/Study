+```yaml
+scrape_configs:
+  - job_name: forgemesh
+    kubernetes_sd_configs:
+      - role: endpointslice
+        namespaces:
+          names: [forgemesh]
+    relabel_configs:
+      - source_labels: [__meta_kubernetes_service_name]
+        regex: forgemesh-control-plane|forgemesh-gateway
+        action: keep
+```
 
