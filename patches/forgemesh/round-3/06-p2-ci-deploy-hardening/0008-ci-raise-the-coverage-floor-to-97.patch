From 42b2b93e4d2d79c78e9a6908aacfca231e8130cd Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 13 Oct 2026 12:24:14 +0000
Subject: [PATCH 08/14] ci: raise the coverage floor to 97%

The floor of 95 was set where the total was 95.87%. On the assembled
1.1.0 stack the CI command (pytest --cov) measures 97.20% (8604
statements, 1912 branches; one run in three gave 97.21%, a single
line depends on timing), so a floor of 95 would let most of the
coverage added by the stacked work drop again unnoticed. Raise it to
97, the floor of the measured value, as the rule that the floor is
only ever raised intends.
---
 CHANGELOG.md   | 2 +-
 pyproject.toml | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 5418c93..7d5947c 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -71,7 +71,7 @@
 - `scripts/compose_smoke.sh` 在第一次对话之后不带凭证抓取一次控制平面与网关的 `/metrics`，核对 Content-Type、若干指标及其此时确定的取值，以及输出不含租户、服务名、key 与实例 id；并带 `traceparent` 经网关读取不存在的服务，核对控制平面的 `404` 信封与日志、网关的访问日志都带同一个 trace-id。实例丢失后重新部署之后与重启控制平面之后再各抓取一次控制平面的 `/metrics`：定期核对与启动时的核对各发现一次丢失，各重新部署一次（重启之后计数从 0 开始），定期核对没有失败，没有回收分配。
 - CI 新增 `package-imports` job 与 `scripts/check_package_imports.py`：为 `packages/` 下的每个包新建一个虚拟环境，只安装这个包（含它的全部 extras）与它声明的依赖（`forgemesh-*` 依赖用本仓库的源码构建），以隔离模式导入根模块，再用 `pkgutil.walk_packages` 导入全部子模块，任一模块导入失败（例如漏声明依赖）即失败。此前 `python` job 把全部包装进同一个环境，漏声明的依赖会被兄弟包或开发依赖掩盖。本地运行 `.venv/bin/python scripts/check_package_imports.py [包目录名...]`（需要网络）。
 - CI 新增 `dependency-audit` job：`pip-audit` 2.10.1 审计 `make install` 装进 `.venv` 的全部第三方包（以 editable 方式安装的本仓库 `forgemesh-*` 包不审计），`govulncheck` v1.9.0 检查网关代码实际调用到的已知漏洞（含标准库）；本地为 `make audit` 与 `make -C gateway vulncheck`。尚无修复或经评估不适用的 Python 漏洞以 `--ignore-vuln` 记入根 `Makefile` 的 `PIP_AUDIT_IGNORE`（目前为空），govulncheck 没有忽略机制；处理规则见 `SECURITY.md` 3.1（同步改写，删去「依赖版本在 CI 中固定」这一并不属实的说法）。
-- pytest 总覆盖率下限：根 `pyproject.toml` 的 `[tool.coverage.report]` 设 `fail_under = 95`（引入时实测 95.87%）与 `precision = 2`（默认取整到整数，94.5% 会被当作 95% 而通过）；CI `python` job 改以 `pytest --cov` 运行，本地为 `make coverage`。下限只升不降。
+- pytest 总覆盖率下限：根 `pyproject.toml` 的 `[tool.coverage.report]` 设 `fail_under = 97`（引入时实测 97.20%）与 `precision = 2`（默认取整到整数，96.5% 会被当作 97% 而通过）；CI `python` job 改以 `pytest --cov` 运行，本地为 `make coverage`。下限只升不降。
 - Kubernetes 网关清单 `deploy/kubernetes/gateway-deployment.yaml`（ServiceAccount、Deployment 与 Service `forgemesh-gateway`，8081 端口）：与控制平面共用 Secret `forgemesh-api-keys`，经 Service `forgemesh-control-plane` 访问控制平面；探针为 `/readyz`（控制平面就绪之后才通过）与 `/healthz`；安全上下文与控制平面一致（非 root、只读根文件系统、去掉全部 capability、`RuntimeDefault` seccomp）；宽限期 35 秒，长于网关排空在途请求的 30 秒。启用启动器时使用 `deploy/kubernetes/launcher/`：`network-policy.yaml` 允许网关访问控制平面 Pod 上推理实例的临时端口（32768–60999），`fake-runtime-patch.yaml` 为控制平面加上来自 ConfigMap `forgemesh-inventory` 的加速器清单与 `fake` 启动器（实例监听全部地址，写进 `status.endpoints` 的主机是 Pod IP）。用法见 README「Kubernetes 部署」，包括 `vllm-process` 在 Kubernetes 上的前提与单节点限制。
 
 ### Changed
diff --git a/pyproject.toml b/pyproject.toml
index 4eaf2d0..dd723cd 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -50,8 +50,8 @@ omit = ["*/tests/*", "*/__init__.py"]
 
 [tool.coverage.report]
 # 总覆盖率下限（`pytest --cov` 与 `coverage report` 都会检查），只升不降。precision 同时是
-# 比较之前取整的位数：默认的 0 会把 94.5% 取整成 95% 而通过。
-fail_under = 95
+# 比较之前取整的位数：默认的 0 会把 96.5% 取整成 97% 而通过。
+fail_under = 97
 precision = 2
 show_missing = true
 skip_covered = false
