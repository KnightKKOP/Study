 .../controlplane/api/dependencies.py          | 12 +++++--
 .../src/forgemesh/controlplane/api/routes.py  | 26 +++++++-------
 tests/unit/controlplane/test_api.py           | 34 ++++++++++++++++---
 4 files changed, 71 insertions(+), 19 deletions(-)

