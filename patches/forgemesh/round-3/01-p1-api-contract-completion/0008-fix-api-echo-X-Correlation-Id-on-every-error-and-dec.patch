+async def get_correlation_id(
+    correlation_id: str | None = Header(default=None, alias=CORRELATION_HEADER),
+) -> str:
+    """本次请求的关联 ID：取 ``X-Correlation-Id`` 请求头，缺失时生成；错误信封回显该值。"""
