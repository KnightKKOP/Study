+def test_readyz_reports_an_uninitialised_registry(tmp_path) -> None:
+    """lifespan 没有运行时 Registry 未初始化：就绪探针报告 503，而不是悄悄打开一个内存库。"""
+    reset_registry()
+    client = TestClient(create_app(db_path=str(tmp_path / "cp.db")))
+
+    response = client.get("/readyz")
