+    )
+    unauthenticated = client.request(method, path, json=body)
+
+    assert resp.status_code == 503, resp.text
+    error = resp.json()["error"]
+    assert (error["code"], error["correlationId"]) == ("REGISTRY_UNAVAILABLE", "corr-1")
