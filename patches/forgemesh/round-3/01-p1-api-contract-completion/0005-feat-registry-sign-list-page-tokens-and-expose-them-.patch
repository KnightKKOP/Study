+    def _encode_page_token(self, scope: str, namespace_key: str, name: str) -> str:
+        """把本页最后一个资源的位置编码为签名游标。"""
+        position = {"v": _PAGE_TOKEN_VERSION, "ns": namespace_key, "name": name}
+        payload = _b64encode(
