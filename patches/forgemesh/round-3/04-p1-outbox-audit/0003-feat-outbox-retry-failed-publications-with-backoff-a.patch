+        real_due = outbox.due
+        calls = 0
+
+        def flaky_due(*args, **kwargs):
+            nonlocal calls
+            calls += 1
+            if calls == 1:
+                raise sqlite3.OperationalError("database is locked")
+            return real_due(*args, **kwargs)
