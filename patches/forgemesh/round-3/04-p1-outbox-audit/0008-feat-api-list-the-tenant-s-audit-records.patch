+    log = get_registry().audit_log
+    for i in range(2):
+        log.record(_event(f"svc-{i}", 100.0 + i, correlation_id="corr-1"))
+    token = _get(client, limit=1).json()["nextPageToken"]
+    for name in ("svc-a", "svc-b"):
