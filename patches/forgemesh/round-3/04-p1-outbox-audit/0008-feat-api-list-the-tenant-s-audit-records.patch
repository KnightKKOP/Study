+def _query_digest(tenant_id: str, correlation_id: str | None) -> str:
+    """一组查询条件的摘要：写入分页令牌，翻页时据此拒绝换了条件的令牌。"""
+    conditions = json.dumps([tenant_id, correlation_id], ensure_ascii=False)
+    return hashlib.sha256(conditions.encode("utf-8")).hexdigest()[:16]
+
+
+def _encode_page_token(last: AuditEvent, digest: str) -> str:
+    """上一页最后一条记录的位置 → 不透明的分页令牌（URL 安全的 base64，无填充）。"""
+    position = {"ts": last.timestamp, "id": last.audit_id, "q": digest}
+    raw = json.dumps(position, separators=(",", ":")).encode("utf-8")
+    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")
+
+
+def _decode_page_token(token: str, digest: str) -> tuple[float, str]:
+    """解析分页令牌，返回上一页最后一条记录的 ``(timestamp, audit_id)``。
+
+    Raises:
+        InvalidPageTokenError: 令牌无法解析，或不是为 ``digest`` 这组查询条件签发的。
+    """
+    try:
+        position = json.loads(base64.urlsafe_b64decode(token + "=" * (-len(token) % 4)))
+    except ValueError:
+        position = None
+    if not isinstance(position, dict) or set(position) != {"ts", "id", "q"}:
+        raise InvalidPageTokenError("page token is malformed")
+    timestamp, audit_id = position["ts"], position["id"]
+    valid = isinstance(timestamp, float) and math.isfinite(timestamp) and isinstance(audit_id, str)
+    if not valid:
+        raise InvalidPageTokenError("page token is malformed")
+    if position["q"] != digest:
+        raise InvalidPageTokenError("page token was issued for a different tenant or filter")
+    return timestamp, audit_id
+
+
+__all__ = ["AuditEvent", "AuditLog", "AuditPage", "InvalidPageTokenError"]
