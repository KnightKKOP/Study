+def _event(
+    resource_id: str,
+    timestamp: float,
+    *,
+    tenant_id: str = TENANT_A,
+    correlation_id: str = "corr",
+    audit_id: str | None = None,
+) -> AuditEvent:
+    ids = {"audit_id": audit_id} if audit_id is not None else {}
+    return AuditEvent(
+        correlation_id=correlation_id,
+        tenant_id=tenant_id,
+        actor="alice",
+        action="create",
+        resource_type="InferenceService",
+        resource_id=resource_id,
+        outcome="success",
+        timestamp=timestamp,
+        **ids,
+    )
