From 91a1a5bc16534b67d978d5a2fcb3c98e19eff054 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 13 Oct 2026 13:58:15 +0000
Subject: [PATCH 4/4] ci: check the formatting with ruff format --check

With the repository formatted, fail the python job (and make lint) when
a change is not formatted the way make fmt formats it, so formatting no
longer depends on each contributor remembering to run it. Document the
check and the pinned ruff series in CONTRIBUTING, the README, SECURITY
and the CHANGELOG.
---
 .github/workflows/ci.yml | 4 ++++
 CHANGELOG.md             | 1 +
 CONTRIBUTING.md          | 4 ++--
 Makefile                 | 5 +++--
 README.md                | 4 ++--
 SECURITY.md              | 2 +-
 6 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 9afcbfe..3d2f011 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -56,6 +56,10 @@ jobs:
       - name: Ruff lint
         run: python -m ruff check .
 
+      # 与 make fmt 的结果不一致时失败；Markdown 不检查（见 pyproject.toml）。
+      - name: Ruff format
+        run: python -m ruff format --check .
+
       # 总覆盖率低于 pyproject.toml 中的 fail_under 时失败。
       - name: Pytest (coverage floor)
         run: python -m pytest --cov
