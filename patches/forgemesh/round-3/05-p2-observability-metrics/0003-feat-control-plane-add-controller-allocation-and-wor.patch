+@pytest.mark.unit
+def test_lock_wait_is_the_time_spent_waiting_for_the_registry_lock() -> None:
+    async def scenario() -> list[float]:
+        registry = SQLiteRegistry()
+        waits: list[float] = []
+        registry.set_lock_wait_observer(waits.append)
+        await registry.ping()
+        registry._lock.acquire()
+        try:
+            contended = asyncio.ensure_future(registry.ping())
+            await asyncio.sleep(0.05)
+        finally:
+            registry._lock.release()
+        await contended
+        registry.set_lock_wait_observer(None)
+        await registry.ping()
+        await registry.close()
+        return waits
+
+    uncontended, contended = _run(scenario())
+    assert 0 <= uncontended < contended
+    assert contended >= 0.03
