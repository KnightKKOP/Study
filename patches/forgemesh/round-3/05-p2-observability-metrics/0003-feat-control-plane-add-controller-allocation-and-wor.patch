     async def _run(self, fn: Callable[[], _T]) -> _T:
         """在工作线程中持锁执行一段同步数据库操作（读写均串行化）。"""
+        observer = self._lock_wait_observer
 
         def _locked() -> _T:
+            waiting = time.perf_counter()
             with self._lock:
+                if observer is not None:
+                    observer(time.perf_counter() - waiting)
                 return fn()
 
         return await asyncio.to_thread(_locked)
 
+    def set_lock_wait_observer(self, observer: Callable[[float], None] | None) -> None:
+        """登记锁等待的观测函数：每次数据库操作取得连接锁后，以等待的秒数调用（指标使用）。"""
