+    # 桶上界是闭区间：0.1 计入 le="0.1"。
+    assert buckets == {"0.1": 2, "1": 3, "5": 4, "+Inf": 5}
+    assert family.value("demo_seconds_count", route="/a") == 5
+    assert family.value("demo_seconds_sum", route="/a") == pytest.approx(63.85)
