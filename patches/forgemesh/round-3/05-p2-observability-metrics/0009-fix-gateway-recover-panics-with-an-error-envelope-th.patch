+	traceID       string
+}
+
+type requestIDsKey struct{}
+
+// requestIDsFrom 返回 Recovery 放入 context 的 requestIDs；链上没有 Recovery 时返回 nil。
+func requestIDsFrom(ctx context.Context) *requestIDs {
