+@pytest.mark.unit
+def test_an_allocation_conflict_without_a_previous_allocation_is_an_allocation_failure():
+    """调度器报告冲突、资源却没有为之前的 generation 持有分配（持有的就是当前幂等键的
+    分配）：AllocationFailed，不停止部署、不释放分配。"""
