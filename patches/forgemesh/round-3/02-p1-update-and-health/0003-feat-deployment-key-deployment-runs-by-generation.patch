+def deployment_run_key(uid: str, generation: int) -> str:
+    """资源 ``uid`` 第 ``generation`` 代 spec 的部署运行的幂等键，也是实例的幂等键
+    （``LaunchRequest.instance_key``），形如 ``deployment:{uid}:{generation}``。
 
