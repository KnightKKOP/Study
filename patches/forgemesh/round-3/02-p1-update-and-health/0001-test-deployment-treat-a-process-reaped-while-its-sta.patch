From 3b740364919e6e04d6dd11f9468efd5768ec2d99 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 13 Oct 2026 14:11:58 +0000
Subject: [PATCH 01/20] test(deployment): treat a process reaped while its stat
 is read as gone

The vLLM launcher tests check that a process has exited by reading
/proc/<pid>/stat. If the process is reaped between opening and reading
the file, the read raises ProcessLookupError rather than
FileNotFoundError, and the helper let it escape, which made tests such
as test_stop_ends_every_process_of_the_instance fail now and then.
Treat both errors as a process that is gone.
---
 tests/unit/controlplane/test_vllm_launcher.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/unit/controlplane/test_vllm_launcher.py b/tests/unit/controlplane/test_vllm_launcher.py
index 9a6d808..f4cf427 100644
--- a/tests/unit/controlplane/test_vllm_launcher.py
+++ b/tests/unit/controlplane/test_vllm_launcher.py
@@ -101,7 +101,7 @@ def _gone(pid: int) -> bool:
     """进程已不存在，或已结束、只等父进程回收（僵尸）。"""
     try:
         stat = Path(f"/proc/{pid}/stat").read_text()
-    except FileNotFoundError:
+    except (FileNotFoundError, ProcessLookupError):
         return True
     return stat.rpartition(")")[2].split()[0] in {"Z", "X"}
 
