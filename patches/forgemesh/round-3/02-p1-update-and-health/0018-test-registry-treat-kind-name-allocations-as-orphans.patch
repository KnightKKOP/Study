From 3338b768b2b0e87875da9ef9ee2288d8cc45524e Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 13 Oct 2026 09:05:52 +0000
Subject: [PATCH 18/20] test(registry): treat kind/name allocations as orphans

Allocations written by 1.0.x are recorded under "{kind}/{name}", which
never matches a resource uid. With deployments enabled, the controller
reclaims them as orphaned allocations even while a resource of that
name exists; no 1.1.0 deployment can use them, and they hold no devices.

Pin this so the changelog can state it, and so a later change to the
orphan query that starts matching names has to revisit the docs.
---
 .../controlplane/test_registry_allocations.py | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/tests/unit/controlplane/test_registry_allocations.py b/tests/unit/controlplane/test_registry_allocations.py
index 640878e..28ec3f0 100644
--- a/tests/unit/controlplane/test_registry_allocations.py
+++ b/tests/unit/controlplane/test_registry_allocations.py
@@ -9,6 +9,7 @@
 * 同名资源在不同命名空间 / 租户中各自持有分配；
 * 释放后设备回到空闲；约束由数据库强制（直接写库、独立连接并发、重启后依然成立）；
 * 归属资源已不存在的 Active 分配列为孤立的分配，只在归属资源仍不存在时标记为 ``Expired``；
+  旧库中以 ``{kind}/{name}`` 记录的分配不对应任何资源，也是孤立的；
 * 打开存量库时以按租户的唯一索引取代旧索引；
 * 持有 Active 分配的资源无论处于哪个 phase，删除都先进入 ``Terminating``。
 
@@ -285,6 +286,24 @@ def test_an_allocation_expires_as_an_orphan_only_while_its_owner_is_gone(registr
     assert asyncio.run(registry.allocated_devices()) == {GPU0}
 
 
+@pytest.mark.unit
+def test_an_allocation_recorded_under_kind_and_name_is_an_orphan(registry):
+    """旧库中以 ``{kind}/{name}`` 记录的分配不对应任何资源的 uid：同名资源存在时也是孤立的
+    分配，可以标记为 Expired；这个资源以 uid 记录的分配不受影响。"""
+    held = _allocate(registry, "gpu-0")
+    legacy_id = asyncio.run(
+        registry.put_allocation(
+            Allocation(resource_id=f"{KIND}/svc", tenant_id=TENANT, idempotency_key="legacy-key")
+        )
+    )
+
+    [orphan] = asyncio.run(registry.list_orphaned_allocations())
+    assert orphan["id"] == legacy_id
+    assert asyncio.run(registry.expire_orphaned_allocation(legacy_id)) is True
+    assert asyncio.run(registry.get_allocation(legacy_id))["status"] == "Expired"
+    assert asyncio.run(registry.get_allocation(held["id"]))["status"] == "Active"
+
+
 @pytest.mark.unit
 def test_allocation_lookups_by_id_and_idempotency_key(registry):
     owner = _put(registry, uid="uid-x", tenant_id=OTHER_TENANT)
