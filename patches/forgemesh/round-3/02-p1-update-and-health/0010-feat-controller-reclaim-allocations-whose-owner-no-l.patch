+                " WHERE r.tenant_id=allocations.tenant_id AND r.uid=allocations.resource_id)",
+                (AllocationStatus.EXPIRED.value, allocation_id, AllocationStatus.ACTIVE.value),
+            )
+            self._conn.commit()
+            return cur.rowcount == 1
+
+        return await self._run(_expire)
