+async def _lose_the_instance(plane: _ControlPlane, launcher: _ScriptedLauncher) -> LaunchedInstance:
+    """服务的实例退出，检查实例时服务转为 Degraded；返回退出的实例。"""
+    [instance] = launcher.running.values()
+    launcher.down.add(instance.instance_id)
