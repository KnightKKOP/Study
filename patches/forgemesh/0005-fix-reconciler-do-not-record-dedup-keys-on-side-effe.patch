From b907a9e044160343de2e7481a8b4276bbabf9cac Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 12 Oct 2026 02:37:12 +0000
Subject: [PATCH 5/8] fix(reconciler): do not record dedup keys on
 side-effect-free failure paths

The deny, require_approval and allocation-failure paths marked the dedup key as
processed and then asked to be requeued. The requeued call hit the idempotency
short-circuit and returned done=True, so a blocked resource was never
re-evaluated until its spec changed or the 24h dedup TTL expired.

None of these paths produced a side effect, so leave the key unmarked.
---
 .../forgemesh/controlplane/reconciler/core.py |  5 +-
 tests/unit/controlplane/test_reconciler.py    | 85 ++++++++++++++++++-
 2 files changed, 86 insertions(+), 4 deletions(-)

diff --git a/packages/control-plane/src/forgemesh/controlplane/reconciler/core.py b/packages/control-plane/src/forgemesh/controlplane/reconciler/core.py
index de18b24..9a8991e 100644
--- a/packages/control-plane/src/forgemesh/controlplane/reconciler/core.py
+++ b/packages/control-plane/src/forgemesh/controlplane/reconciler/core.py
@@ -164,8 +164,9 @@ class ReconciliationController(Reconciler):
             resource={"kind": resource.kind, "name": resource.metadata.name},
         )
         policy_result = await self._policy.check(ctx, action)
+        # deny / require_approval / 分配失败均未产生副作用：不登记 dedup_key，
+        # 否则 requeue 回来会命中幂等短路，永远不会重新评估。
         if policy_result.decision == "deny":
-            await self._mark_processed(ctx.dedup_key)
             return ReconcileResult(
                 done=False,
                 requeue_after=30.0,
@@ -186,7 +187,6 @@ class ReconciliationController(Reconciler):
             # 工作流），requeue 等待人工审批后重新协调（对齐
             # development-plan 5.6 三态 / architecture 7.5——高风险操作
             # 不允许在审批前放行）
-            await self._mark_processed(ctx.dedup_key)
             return ReconcileResult(
                 done=False,
                 requeue_after=30.0,
@@ -216,7 +216,6 @@ class ReconciliationController(Reconciler):
                 allocation_ref = await self._scheduler.allocate(sched_req)
             except Exception as exc:  # noqa: BLE001 - 分配失败需可重试
                 logger.warning("scheduler allocate failed: %s", exc)
-                await self._mark_processed(ctx.dedup_key)
                 return ReconcileResult(
                     done=False,
                     requeue_after=10.0,
