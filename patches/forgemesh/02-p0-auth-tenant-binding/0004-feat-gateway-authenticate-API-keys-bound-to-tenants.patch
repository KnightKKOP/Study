+	env := newInferenceEnv(t, http.StatusForbidden)
+
+	rec := env.chat(routerKeyTenantA)
+	if rec.Code != http.StatusForbidden || !strings.Contains(rec.Body.String(), `"code":"FORBIDDEN"`) {
