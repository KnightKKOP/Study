+async def get_principal(request: Request) -> Principal:
+    """校验请求凭证，返回已验证的调用主体。
+
+    认证器未注入返回 503（组装缺失时拒绝而不是放行）；凭证缺失或无效返回 401
+    （附 ``WWW-Authenticate``）；凭证有效但越权（如租户头与凭证不符）返回 403。
+    """
