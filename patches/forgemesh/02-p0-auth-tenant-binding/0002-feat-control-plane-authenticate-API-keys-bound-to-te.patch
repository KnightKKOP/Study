+def get_authenticator() -> Authenticator:
+    """获取已注入的认证器；未注入时抛 :class:`ComponentNotReadyError`。"""
+    if _authenticator is None:
+        raise ComponentNotReadyError(
+            "Authenticator 未注入：请先调用 init_authenticator(...) 完成组装。"
+        )
+    return _authenticator
+
