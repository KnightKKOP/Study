 gateway/internal/middleware/ratelimit.go      | 32 +++-------
 gateway/internal/middleware/ratelimit_test.go | 62 ++++++++++++++-----
 gateway/internal/router/router.go             |  2 +-
 4 files changed, 58 insertions(+), 40 deletions(-)

