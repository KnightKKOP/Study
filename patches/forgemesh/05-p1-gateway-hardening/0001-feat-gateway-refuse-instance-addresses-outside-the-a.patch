+	if cfg.InstanceAllowedCIDRs, err = parseCIDRs(os.Getenv(envInstanceAllowedCIDRs)); err != nil {
+		return Config{}, fmt.Errorf("config: %s %w", envInstanceAllowedCIDRs, err)
+	}
+
