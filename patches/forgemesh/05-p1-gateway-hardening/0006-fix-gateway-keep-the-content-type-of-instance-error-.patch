From 9b69243e0bf819d4381fbb0f3ffa9961019f6c52 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 12 Oct 2026 06:00:00 +0000
Subject: [PATCH 6/7] fix(gateway): keep the content type of instance error
 responses

The stream proxy set Content-Type: text/event-stream on every
response, so a JSON error from the instance (for example a vLLM 400
for an invalid parameter) reached the client labelled as an event
stream. Only 2xx responses are marked as event streams now; error
responses keep the instance's Content-Type.
---
 gateway/internal/stream/proxy.go      |  9 +++++---
 gateway/internal/stream/proxy_test.go | 31 +++++++++++++++++++++++++++
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/gateway/internal/stream/proxy.go b/gateway/internal/stream/proxy.go
index f7fb3d7..a0f066c 100644
--- a/gateway/internal/stream/proxy.go
+++ b/gateway/internal/stream/proxy.go
@@ -1,7 +1,8 @@
 // Package stream 实现 SSE / 流式分块的透明代理。
 //
 // 与普通反代的区别：
-//   - 设置 text/event-stream 并禁用各级缓冲（含 nginx 的 X-Accel-Buffering）。
+//   - 成功响应设置 text/event-stream（错误响应保留实例的 Content-Type），并禁用各级
+//     缓冲（含 nginx 的 X-Accel-Buffering）。
 //   - 逐块读取上游响应并立即 Flush，保证 token 实时到达客户端。
 //   - 通过继承客户端请求的 context，客户端断开会自动取消上游请求，避免资源泄漏。
 //
@@ -198,8 +199,10 @@ func (p *Proxy) forward(w http.ResponseWriter, r *http.Request, upstreamURL, end
 		}
 		dst[k] = append([]string(nil), vs...)
 	}
-	// 强制流式语义。
-	dst.Set("Content-Type", "text/event-stream")
+	// 成功响应强制流式语义；错误响应保留实例的 Content-Type，客户端才能按格式解析错误体。
+	if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+		dst.Set("Content-Type", "text/event-stream")
+	}
 	dst.Set("Cache-Control", "no-cache")
 	dst.Set("Connection", "keep-alive")
 	// 关闭 nginx 等中间层对响应的缓冲。
diff --git a/gateway/internal/stream/proxy_test.go b/gateway/internal/stream/proxy_test.go
index e1aa7ce..fe34259 100644
--- a/gateway/internal/stream/proxy_test.go
+++ b/gateway/internal/stream/proxy_test.go
@@ -705,6 +705,37 @@ func TestProxy_Upstream5xxCountsFailure(t *testing.T) {
 	}
 }
 
+// TestProxy_ErrorResponseKeepsContentType 验证实例的错误响应保留原 Content-Type 与响应体，
+// 不被改成 text/event-stream。
+func TestProxy_ErrorResponseKeepsContentType(t *testing.T) {
+	const errBody = `{"object":"error","message":"max_tokens is too large","code":400}`
+	upstreamSrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusBadRequest)
+		_, _ = w.Write([]byte(errBody))
+	}))
+	defer upstreamSrv.Close()
+
+	res := newFakeResolver([]string{upstreamSrv.URL}, nil)
+	proxy := New(res, "X-Tenant-ID", allowLoopback, nil)
+
+	rec := httptest.NewRecorder()
+	proxy.ServeHTTP(rec, newChatRequest("svc-a"))
+
+	if rec.Code != http.StatusBadRequest {
+		t.Fatalf("4xx 应透传，实际 %d", rec.Code)
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("错误响应应保留实例的 Content-Type application/json，实际 %q", ct)
+	}
+	if got := rec.Body.String(); got != errBody {
+		t.Fatalf("错误响应体应原样透传，\nwant %q\ngot  %q", errBody, got)
+	}
+	if got := res.failureCount(upstreamSrv.URL); got != 0 {
+		t.Fatalf("4xx 不应计实例失败，实际 %d", got)
+	}
+}
